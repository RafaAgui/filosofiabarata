---
import MainFooter from "../components/layout/Footer.astro";
import MainHeader from "../components/layout/Header.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<title>rafaelaguilara-blog"</title>
	</head>
	<body>
		<div class='main-container'>

			<MainHeader />

			<div class='main'>
				<main class='main-page'>
					<slot />
				</main>
			</div>

			<MainFooter />

		</div>
	</body>
</html>

<style lang="scss" is:global>
@use "../assets/variables";
:root {
  line-height: 1.5;
  font-weight: 400;

  color-scheme: light dark;
  color: rgba(255, 255, 255, 0.87);
  background-color: oklch(97.8% 0.003 70);

  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

html, body {
  height: 100%;
  margin: 0;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  font-family: 'Sarabun', sans-serif;
  font-weight: 400;
  font-style: normal;
  background: oklch(97.8% 0.003 70);
	color: #000000;
}

.bold {
  font-weight: 700;
  font-style: normal;
}

.italic {
  font-weight: 400;
  font-style: italic;
}

