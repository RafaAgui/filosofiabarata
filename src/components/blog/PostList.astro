---
import { getCollection, type CollectionEntry } from "astro:content";
import "../../styles/components/Filosofiabarata.scss";
import FilosofiabarataPosts from "./FilosofiabarataPosts";
import type { Post } from "../../types/blog";

const entries: CollectionEntry<'filosofiabarata'>[] = await getCollection('filosofiabarata');

const posts: Post[] = entries
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((entry) => ({
    slug: entry.slug,
    title: entry.data.title,
    date: entry.data.date.toISOString().split('T')[0],
    categorias: entry.data.categorias,
    description: entry.data.description ?? '',
  }));
---

<section>
  <FilosofiabarataPosts posts={posts} client:load />
</section>
