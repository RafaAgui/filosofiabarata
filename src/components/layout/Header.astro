---
  import Menu from 'lucide-astro/Menu';
  import Search from 'lucide-astro/Search';
  import '../../styles/components/Header.scss';
---

<header class="header">
  <div class="header__top">

    <div class="header__logo">
    <h1 class="header__title">
      <a href="/">La filosofía barata</a>
    </h1>
    <p>Explorando el pensamiento filosófico sin complicaciones.</p>
    </div>
    <nav class="header__nav">
      <ul class="header__nav-list">
        <li><a href="/categorias" class="header__nav-link">Categories</a></li>
        <li><a href="/about" class="header__nav-link">About</a></li>
      </ul>
    </nav>
    <button class="header__btn header__btn--search" aria-label="Buscar" style="display: none;">
      <Search size="24" />
    </button>
    <button class="header__btn header__btn--theme" id="theme-toggle" aria-label="Cambiar tema">
      <!-- Sun icon (shown in dark mode) -->
      <svg class="theme-icon theme-icon--sun" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
      </svg>
      <!-- Moon icon (shown in light mode) -->
      <svg class="theme-icon theme-icon--moon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
      </svg>
    </button>
        <button class="header__btn header__btn--menu" aria-label="Abrir menú">
      <Menu size="24" />
    </button>
  </div>

  <div class="header__drawer" id="header-drawer">
    <ul class="header__drawer-list">
      <li><a href="/categorias" class="header__drawer-link">Categories</a></li>
      <li><a href="/about" class="header__drawer-link">About</a></li>
    </ul>
  </div>
</header>

<script>
  const menuBtn = document.querySelector('.header__btn--menu');
  const drawer = document.getElementById('header-drawer');
  menuBtn?.addEventListener('click', () => {
    drawer?.classList.toggle('header__drawer--open');
  });

  const themeToggle = document.getElementById('theme-toggle');
  const root = document.documentElement;

  function applyTheme(theme: string) {
    root.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
  }

  themeToggle?.addEventListener('click', () => {
    const current = root.getAttribute('data-theme');
    applyTheme(current === 'dark' ? 'light' : 'dark');
  });
</script>
